{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend API (.NET)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/backend/Symbio.API/Symbio.API.csproj"
    },
    {
      "name": "Debug Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend/Symbio.Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "serverReadyAction": {
        "pattern": "local:.*(http://\\S+)",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Both (Full Stack)",
      "configurations": ["Debug Backend API (.NET)", "Debug Frontend (Vite)"]
    }
  ]
}
