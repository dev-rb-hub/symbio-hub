{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SymbioHub.db"
  },
  "Cosmos": {
    "ConnectionString": "",
    "DatabaseName": "SymbioHub",
    "ContainerName": "Projects",
    "TalentContainerName": "TalentProfiles",
    "CompletionEvidenceContainerName": "CompletionEvidence"
  },
  "Pinch": {
    "BaseUri": "https://api.getpinch.com.au",
    "AuthUri": "https://auth.getpinch.com.au",
    "IsLive": false,
    "MerchantId": "",
    "ApplicationId": "",
    "SecretKey": "",
    "ApiSecret": "",
    "WebhookSecret": "",
    "ValidateWebhookSignature": true,
    "WebhookSignatureHeader": "pinch-signature",
    "WebhookSignatureVersion": "v2",
    "WebhookToleranceSeconds": 300
  },
  "Payments": {
    "DebitWorkerIntervalSeconds": 20,
    "RetainerWorkerIntervalSeconds": 30
  }
}