{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/symbio-api-.log",
          "rollingInterval": "Day",
          "shared": true,
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SymbioHub-Dev",
    "Audience": "SymbioHub-Clients"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=SymbioHub.db"
  },
  "Cosmos": {
    "ConnectionString": "",
    "DatabaseName": "SymbioHub",
    "ContainerName": "Projects",
    "TalentContainerName": "TalentProfiles",
    "CompletionEvidenceContainerName": "CompletionEvidence"
  },
  "Pinch": {
    "BaseUri": "https://api.getpinch.com.au",
    "AuthUri": "https://auth.getpinch.com.au",
    "IsLive": false,
    "MerchantId": "",
    "ApplicationId": "",
    "SecretKey": "",
    "ApiKey": "",
    "ApiSecret": "",
    "WebhookSecret": "",
    "ValidateWebhookSignature": false,
    "WebhookSignatureHeader": "pinch-signature",
    "WebhookSignatureVersion": "v2",
    "WebhookToleranceSeconds": 300
  },
  "Payments": {
    "DebitWorkerIntervalSeconds": 10,
    "RetainerWorkerIntervalSeconds": 15
  }
}
